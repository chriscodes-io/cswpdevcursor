# Server
PORT=3001
APP_URL=https://cswp.dev

# Agiled Public API (https://api.agiled.ai/public/v1)
AGILED_API_BASE_URL=https://api.agiled.ai/public/v1
AGILED_API_KEY=

# Required for /api/crm/* proxy calls. Send as Authorization: Bearer <token>.
CRM_PROXY_TOKEN=

# Webhook secret shown once when creating a subscription in Agiled
AGILED_WEBHOOK_SECRET=

# Optional: delete the legacy https://cswp.dev/crm subscription during setup
AGILED_LEGACY_WEBHOOK_SUBSCRIPTION_ID=019e9fcd-0d2e-7b2a-ad03-f8b1f61e2b9f

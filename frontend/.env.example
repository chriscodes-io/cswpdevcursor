# Local development
REACT_APP_BACKEND_URL=http://localhost:8001
REACT_APP_ALLOW_SIGNUP=true
# Optional: set when the audit email service is hosted on a different origin.
REACT_APP_AUDIT_API_URL=
# Prevents Create React App from auto-opening a browser tab on npm start
BROWSER=none


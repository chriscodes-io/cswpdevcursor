# Production API environment — paste into Railway or Render (service: backend/)
# Do not commit real secrets. Copy to a password manager / host env UI.
#
# Domains (Spaceship DNS):
#   api.cswp.dev  →  CNAME to your Railway/Render host

# --- Required ---
MONGO_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
DB_NAME=seo_project_manager
JWT_SECRET=
DEV_AUTH_FALLBACK=false
ALLOW_PUBLIC_REGISTRATION=false

FRONTEND_URL=https://app.cswp.dev
CORS_ORIGINS=https://app.cswp.dev,https://chrissmithwp.com

# --- CRM ---
USE_AGILED_CRM=true
AGILED_API_KEY=
AGILED_API_BASE_URL=https://api.agiled.ai/public/v1

# --- Email ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=hello@chrissmithwp.com
CONTACT_TO_EMAIL=hello@chrissmithwp.com

# --- Payments (optional at launch) ---
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Audits (optional) ---
GOOGLE_PAGESPEED_API_KEY=

# Stripe webhook URL after deploy:
#   https://api.cswp.dev/api/webhook/stripe

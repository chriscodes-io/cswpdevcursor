# Production environment for the CSWP backend container.
# Copy to backend/.env on the server and fill in values.

PORT=3001
APP_URL=https://cswp.dev

AGILED_API_BASE_URL=https://api.agiled.ai/public/v1
AGILED_API_KEY=

# From Agiled Settings → API → Webhooks (shown once at subscription creation)
AGILED_WEBHOOK_SECRET=

# Optional: legacy subscription id to remove when running setup:webhook
AGILED_LEGACY_WEBHOOK_SUBSCRIPTION_ID=

# MongoDB — local dev defaults. For production, override in backend/.env.local
MONGO_URL=mongodb://localhost:27017/
DB_NAME=seo_project_manager

# Auth
JWT_SECRET=change-me-in-production
DEV_AUTH_FALLBACK=true
ALLOW_PUBLIC_REGISTRATION=true
FRONTEND_URL=http://localhost:3000

# CRM
USE_AGILED_CRM=true
# AGILED_API_KEY=           # or set in services/agiled/.env (auto-loaded)
# AGILED_API_BASE_URL=https://api.agiled.ai/public/v1

# CORS (comma-separated origins in production)
CORS_ORIGINS=http://localhost:3000

# Non-secret service defaults — put real API keys in backend/.env.local
GOOGLE_PAGESPEED_API_KEY=
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
CONTACT_TO_EMAIL=

# Copy to backend/.env.local (gitignored) for production / Atlas.
# See docs/ATLAS_SETUP.md for the full walkthrough.

# --- MongoDB Atlas (required for production auth) ---
MONGO_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
DB_NAME=seo_project_manager
DEV_AUTH_FALLBACK=false

# --- Auth ---
# python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ALLOW_PUBLIC_REGISTRATION=false
FRONTEND_URL=https://app.cswp.dev
CORS_ORIGINS=https://app.cswp.dev,https://chrissmithwp.com,http://localhost:3000

# --- CRM (Agiled) ---
USE_AGILED_CRM=true
AGILED_API_KEY=
AGILED_API_BASE_URL=https://api.agiled.ai/public/v1

# --- Email (password reset + contact form) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=
CONTACT_TO_EMAIL=

# --- Payments & audits ---
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
GOOGLE_PAGESPEED_API_KEY=
